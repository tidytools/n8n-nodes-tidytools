{
  "name": "n8n-nodes-tidytools",
  "version": "0.1.0",
  "description": "n8n node for TidyTools: website contact extraction, SEO audits and AI web data extraction (RapidAPI key), audio/video transcription and website classification (Apify token).",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "tidytools",
    "contact extractor",
    "email finder",
    "seo audit",
    "web scraping",
    "ai extraction",
    "transcription",
    "speech to text",
    "website classification",
    "rapidapi",
    "apify"
  ],
  "license": "MIT",
  "homepage": "https://github.com/tidytools/n8n-nodes-tidytools#readme",
  "author": {
    "name": "TidyTools",
    "email": "tidytools@yukai.uk"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tidytools/n8n-nodes-tidytools.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/run.test.mjs",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist",
    "examples"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/TidyToolsRapidApi.credentials.js",
      "dist/credentials/TidyToolsApifyApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/TidyTools/TidyTools.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.53.4",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^19.0.4",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
